# ===========================================
# 武俱打卡 - 环境变量配置
# 复制此文件为 .env 并修改配置
# ===========================================

# ---------- MinIO 配置 ----------
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin

# ---------- 微信小程序配置 ----------
# 需要在微信公众平台获取
WX_APP_ID=your-wx-app-id
WX_SECRET=your-wx-app-secret
WX_TEMPLATE_ID=your-subscribe-template-id
WX_REMIND_HOUR=20

# ---------- API Server 配置 ----------
API_PORT=8080
API_MODE=debug                    # debug / release
JWT_SECRET=wuxie-jwt-secret-change-in-production
JWT_EXPIRES=72                    # Token有效期(小时)

# ---------- Media Server 配置 ----------
MEDIA_PORT=8081
FFMPEG_WORKERS=2                  # 转码Worker并发数

# ---------- MongoDB 配置 ----------
MONGO_PORT=27017

# ---------- Redis 配置 ----------
REDIS_PORT=6379

# ---------- Nginx 配置 ----------
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
