<cu-custom bgColor="bg-gradual-blue" isCustom="{{false}}"><view slot="content">武协打卡小程序</view></cu-custom>
 <view wx:if="{{canIUse}}" class='container'>
    <view class='header'>
      <text>授权登陆</text>
    </view>
    <open-data class="open-data-userAvatarUrl" type="userAvatarUrl"></open-data>
    <open-data class="open-data-userNickName line1" type="userNickName"></open-data>
    <view class='content'>
      <view>申请获取以下权限</view>
      <text>获得你的公开信息(昵称，头像等)</text>
    </view>

  <view class="padding flex flex-direction">
    <button class='cu-btn bg-blue margin-tb-sm lg' type='primary' open-type="getUserInfo" lang="zh_CN" bindgetuserinfo="bindGetUserInfo">
        授权登录
      </button>
  </view>
  </view>

<view wx:else class='container'>请升级微信版本</view>
